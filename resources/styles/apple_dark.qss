/* ============================================
   ICE V1.0 — Apple Glassmorphism Light 主题
   ============================================ */

/* --- 全局默认 --- */
* {
    font-family: "Inter", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
    color: #1E293B;
    selection-background-color: #3B82F6;
    selection-color: #FFFFFF;
}

/* --- 主窗口 --- */
QMainWindow {
    background-color: #F5F6FA;
}

/* --- 侧边栏 --- */
#sidebar {
    background-color: rgba(255, 255, 255, 0.75);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    min-width: 188px;
    max-width: 188px;
}

#sidebar QLabel#sectionTitle {
    font-size: 11px;
    font-weight: 600;
    color: rgba(30, 41, 59, 0.4);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 12px 20px 6px 20px;
}

#sidebar QLabel#logoText {
    font-size: 18px;
    font-weight: 700;
    color: #1E293B;
    padding: 18px 12px 8px 12px;
}

/* --- 分组标题按钮 --- */
#groupHeader {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 7px 10px;
    margin: 4px 6px;
    color: #64748B;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
}

#groupHeader:hover {
    background-color: rgba(0, 0, 0, 0.04);
    color: #334155;
}

/* --- 首页按钮 --- */
#homeNavItem {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 7px 10px;
    margin: 2px 6px 6px 6px;
    color: #64748B;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}

#homeNavItem:hover {
    background-color: rgba(0, 0, 0, 0.04);
    color: #1E293B;
}

#homeNavItem[active="true"] {
    background-color: rgba(59, 130, 246, 0.1);
    color: #3B82F6;
    font-weight: 500;
}

/* --- 导航项 --- */
#navItem {
    background-color: transparent;
    border-radius: 8px;
    padding: 7px 8px;
    margin: 1px 6px;
    color: #64748B;
    font-size: 13px;
    font-weight: 450;
}

#navItem:hover {
    background-color: rgba(0, 0, 0, 0.04);
    color: #1E293B;
}

#navItem[active="true"] {
    background-color: rgba(59, 130, 246, 0.1);
    color: #3B82F6;
    font-weight: 500;
}

#navItem[active="true"]:hover {
    background-color: rgba(59, 130, 246, 0.16);
}

/* --- 内容区域 --- */
#contentArea {
    background-color: #F5F6FA;
}

/* --- 毛玻璃卡片 --- */
#glassCard {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
    padding: 24px;
}

#glassCard:hover {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.1);
}

/* --- 模块页面标题 --- */
#pageTitle {
    font-size: 24px;
    font-weight: 700;
    color: #334155;
    padding-bottom: 4px;
}

#pageDescription {
    font-size: 15px;
    color: #718096;
    padding-bottom: 24px;
    line-height: 1.6;
}

/* --- 毛玻璃按钮 --- */
#glassButton {
    background-color: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.18);
    border-radius: 8px;
    padding: 8px 20px;
    color: #3B82F6;
    font-size: 13px;
    font-weight: 500;
}

#glassButton:hover {
    background-color: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.3);
}

#glassButton:pressed {
    background-color: rgba(59, 130, 246, 0.2);
}

#glassButton#accentButton {
    background-color: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.18);
    color: #22C55E;
}

#glassButton#accentButton:hover {
    background-color: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(34, 197, 94, 0.3);
}

#glassButton#dangerButton {
    background-color: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.15);
    color: #EF4444;
}

#glassButton#dangerButton:hover {
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
}

/* --- 毛玻璃输入框 --- */
#glassInput {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 8px 14px;
    color: #1E293B;
    font-size: 13px;
    selection-background-color: #3B82F6;
}

#glassInput[editable="false"] {
    background-color: rgba(248, 250, 252, 0.98);
    border: 1px solid rgba(59, 130, 246, 0.18);
    color: #1E293B;
}

#glassInput[editable="true"] {
    background-color: rgba(255, 255, 255, 1);
    border: 1px solid rgba(37, 99, 235, 0.5);
    color: #0F172A;
}

#glassInput:focus {
    border: 1px solid rgba(59, 130, 246, 0.4);
    background-color: rgba(255, 255, 255, 1);
}

#glassInput:hover {
    border: 1px solid rgba(0, 0, 0, 0.14);
}

#glassInput::placeholder {
    color: #94A3B8;
}

/* --- 输入框标签 --- */
#inputLabel {
    font-size: 12px;
    font-weight: 500;
    color: #64748B;
    padding-bottom: 4px;
}

/* --- 文本编辑区（输出/终端） --- */
#terminalOutput {
    background-color: rgba(248, 250, 252, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
    padding: 10px;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    color: #334155;
    selection-background-color: #3B82F6;
}

#targetAddressInput {
    background-color: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(37, 99, 235, 0.24);
    border-radius: 10px;
    padding: 10px;
    color: #0F172A;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #3B82F6;
}

#targetAddressInput:focus {
    background-color: #FFFFFF;
    border: 1px solid rgba(37, 99, 235, 0.55);
}

#portRangeInput {
    background-color: rgba(248, 250, 252, 0.98);
    border: 1px solid rgba(37, 99, 235, 0.24);
    border-radius: 10px;
    padding: 10px;
    color: #0F172A;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #3B82F6;
}

#portRangeInput[editable="false"] {
    background-color: rgba(248, 250, 252, 0.98);
    border: 1px solid rgba(37, 99, 235, 0.24);
    color: #0F172A;
}

#portRangeInput[editable="true"] {
    background-color: #FFFFFF;
    border: 1px solid rgba(37, 99, 235, 0.58);
    color: #0F172A;
}

#portRangeInput:focus {
    background-color: #FFFFFF;
    border: 1px solid rgba(37, 99, 235, 0.55);
}

#configSummary {
    color: #64748B;
    font-size: 12px;
}

#scanStatus {
    color: #2563EB;
    font-size: 12px;
    font-weight: 500;
}

#scanProgressBar {
    background-color: rgba(248, 250, 252, 0.96);
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 7px;
    color: #1E293B;
    font-size: 11px;
    min-height: 18px;
    max-height: 18px;
    text-align: center;
}

#scanProgressBar::chunk {
    background-color: rgba(59, 130, 246, 0.68);
    border-radius: 6px;
}

#sectionTitle {
    color: #334155;
    font-size: 13px;
    font-weight: 650;
}

#compactModeButton {
    background-color: rgba(248, 250, 252, 0.98);
    border: 1px solid rgba(37, 99, 235, 0.22);
    border-radius: 7px;
    padding: 4px 8px;
    color: #1D4ED8;
    font-size: 11px;
    font-weight: 600;
}

#compactModeButton:hover {
    background-color: rgba(219, 234, 254, 0.9);
    border: 1px solid rgba(37, 99, 235, 0.36);
}

#compactModeButton:checked {
    background-color: rgba(37, 99, 235, 0.16);
    border: 1px solid rgba(37, 99, 235, 0.58);
    color: #1E40AF;
}

#portResultTable {
    background-color: rgba(248, 250, 252, 0.96);
    alternate-background-color: rgba(241, 245, 249, 0.78);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 10px;
    gridline-color: rgba(15, 23, 42, 0.06);
    color: #1F2937;
    selection-background-color: rgba(59, 130, 246, 0.18);
    selection-color: #0F172A;
}

#portResultTable::item {
    padding: 5px 8px;
}

#portResultTable QHeaderView::section {
    background-color: rgba(226, 232, 240, 0.88);
    border: none;
    border-right: 1px solid rgba(15, 23, 42, 0.08);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    padding: 7px 8px;
    color: #334155;
    font-size: 12px;
    font-weight: 650;
}

/* --- 底部设置栏 --- */
#settingsBar {
    background-color: rgba(255, 255, 255, 0.8);
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    min-height: 48px;
    max-height: 48px;
}

#settingsBar QLabel {
    font-size: 12px;
    color: #64748B;
}

#settingsBar QPushButton {
    background-color: transparent;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 6px;
    padding: 4px 12px;
    color: #64748B;
    font-size: 11px;
}

#settingsBar QPushButton:hover {
    background-color: rgba(0, 0, 0, 0.04);
    color: #334155;
    border: 1px solid rgba(0, 0, 0, 0.1);
}

/* --- 设置面板 --- */
#settingsPanel {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
}

#settingsPanel QLabel#settingsTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1E293B;
}

#settingsPanel QLineEdit#glassInput {
    padding: 6px 14px;
    min-height: 26px;
}

#settingsPanel QCheckBox#glassCheckbox {
    min-height: 24px;
    padding: 2px 0px;
}

/* --- 设置面板选项卡 --- */
#settingsTab {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
}

#settingsTab:hover {
    color: #475569;
}

#settingsTab[active="true"] {
    background-color: rgba(59, 130, 246, 0.08);
    color: #3B82F6;
}

/* --- 滚动条 --- */
QScrollBar:vertical {
    background-color: rgba(0, 0, 0, 0.03);
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.2);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: rgba(0, 0, 0, 0.03);
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.2);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- 分隔线 --- */
#divider {
    background-color: rgba(0, 0, 0, 0.06);
    min-height: 1px;
    max-height: 1px;
}

/* --- ComboBox 下拉框 --- */
#glassCombo {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 8px 14px;
    color: #1E293B;
    font-size: 13px;
}

#glassCombo:hover {
    border: 1px solid rgba(0, 0, 0, 0.14);
}

#glassCombo:focus {
    border: 1px solid rgba(59, 130, 246, 0.4);
}

#glassCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid rgba(0, 0, 0, 0.06);
}

#glassCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: rgba(59, 130, 246, 0.12);
    selection-color: #1E293B;
}

/* --- CheckBox --- */
#glassCheckbox {
    color: #64748B;
    font-size: 12px;
    spacing: 8px;
}

#glassCheckbox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background-color: rgba(255, 255, 255, 0.8);
}

#glassCheckbox::indicator:checked {
    background-color: #3B82F6;
    border: 1px solid #3B82F6;
}

/* --- SpinBox --- */
#glassSpinBox {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 8px;
    padding: 8px 14px;
    color: #1E293B;
    font-size: 13px;
    min-height: 20px;
}

#glassSpinBox:hover {
    border: 1px solid rgba(0, 0, 0, 0.14);
}

#glassSpinBox:focus {
    border: 1px solid rgba(59, 130, 246, 0.4);
}

/* --- 免责声明 --- */
#disclaimerBox {
    background-color: rgba(248, 250, 252, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 12px;
}

#disclaimerTitle {
    font-size: 13px;
    font-weight: 650;
    color: #64748B;
    padding-bottom: 6px;
}

#disclaimerText {
    font-size: 12px;
    color: #94A3B8;
    line-height: 1.7;
}

/* --- 状态指示器 --- */
#statusDot[status="idle"] {
    background-color: #94A3B8;
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}

#statusDot[status="running"] {
    background-color: #22C55E;
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}

#statusDot[status="error"] {
    background-color: #EF4444;
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}

/* --- 右键菜单（全局） --- */
QMenu {
    background-color: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    padding: 6px;
    color: #1E293B;
}

QMenu::item {
    padding: 7px 32px 7px 14px;
    border-radius: 6px;
    color: #1E293B;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: rgba(59, 130, 246, 0.12);
    color: #1E293B;
}

QMenu::item:disabled {
    color: #94A3B8;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(0, 0, 0, 0.08);
    margin: 4px 10px;
}

QMenu::indicator {
    margin-left: 6px;
}
